# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One Google key serving both the Generative Language API and the Drive API.
# Both must be enabled on the same Cloud project and the key must not be
# restricted to only one of them (AI Studio keys are restricted by default).
GEMINI_API_KEY=

# Shared secret guarding /api/cron/retry
CRON_SECRET=
