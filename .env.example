# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini only. This key cannot be used for Drive — see below.
GEMINI_API_KEY=

# Google Drive access, as a service account.
#
# The Drive API rejects API keys outright ("API keys are not supported by this
# API"), even for a file shared with "Anyone with the link", so Drive needs a
# real principal. Paste the service account's JSON key here, either raw or
# base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared secret guarding /api/cron/retry
CRON_SECRET=
